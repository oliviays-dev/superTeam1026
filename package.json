{
  "name": "pluginmax-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pluginmax engineering platform",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "build:packages": "pnpm --filter './packages/*' build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "db:down": "./scripts/db-compose.sh down",
    "db:migrate": "pnpm --filter @pluginmax/database migrate",
    "db:up": "./scripts/db-compose.sh up -d postgres",
    "migration:principal-dry-run": "tsx packages/database/src/legacy-principal-dry-run-cli.ts",
    "dev": "pnpm run build:packages && pnpm --parallel --filter @pluginmax/api --filter @pluginmax/worker --filter @pluginmax/web run dev",
    "dev:api": "pnpm --filter @pluginmax/api dev",
    "dev:web": "pnpm --filter @pluginmax/web dev",
    "dev:worker": "pnpm --filter @pluginmax/worker dev",
    "format:check": "prettier --check .",
    "lint": "oxlint apps packages",
    "test": "vitest run",
    "test:e2e": "./scripts/e2e-smoke.sh",
    "test:e2e:browser": "playwright test",
    "test:ci": "./scripts/ci-runtime-e2e.sh",
    "test:smoke:collaboration": "./scripts/task-collaboration-smoke.sh",
    "test:smoke:dependencies": "./scripts/dependency-memory-smoke.sh",
    "test:smoke:workflow": "./scripts/workflow-markdown-smoke.sh",
    "test:smoke:workflow-agent": "./scripts/workflow-agent-smoke.sh",
    "test:smoke:workflow-runtime": "./scripts/workflow-runtime-smoke.sh",
    "test:smoke:workflow-postgres": "./scripts/workflow-postgres-smoke.sh",
    "test:smoke:workflow-governance": "./scripts/workflow-governance-smoke.sh",
    "test:smoke:runtime": "./scripts/runtime-reliability-smoke.sh",
    "test:smoke:runtime-postgres": "./scripts/runtime-postgres-smoke.sh",
    "test:smoke:maintenance-postgres": "./scripts/maintenance-effects-postgres-smoke.sh",
    "test:smoke:production-postgres": "./scripts/production-readiness-postgres-smoke.sh",
    "test:smoke:meeting-decisions": "./scripts/meeting-decisions-smoke.sh",
    "test:smoke:meeting-decisions-postgres": "./scripts/meeting-decisions-postgres-smoke.sh",
    "test:integration:meeting-ai": "./scripts/meeting-ai-participation-vitest.sh",
    "test:integration:ai-direct-chat": "./scripts/ai-direct-chat-vitest.sh",
    "test:smoke:meeting-ai-postgres": "./scripts/meeting-ai-participation-postgres-smoke.sh",
    "test:smoke:meeting-ai": "./scripts/meeting-ai-participation-smoke.sh",
    "test:e2e:meeting-ai": "./scripts/meeting-ai-participation-smoke.sh",
    "test:e2e:ai-direct-chat": "./scripts/ai-direct-chat-smoke.sh",
    "test:smoke:memory-closure": "./scripts/memory-closure-smoke.sh",
    "test:smoke:memory-closure-postgres": "./scripts/memory-closure-postgres-smoke.sh",
    "test:smoke:workbench-reports": "./scripts/workbench-reports-smoke.sh",
    "test:smoke:workbench-reports-postgres": "./scripts/workbench-reports-postgres-smoke.sh",
    "test:e2e:workbench-reports": "./scripts/workbench-reports-e2e.sh",
    "test:smoke:project-templates": "./scripts/project-templates-smoke.sh",
    "test:smoke:project-templates-postgres": "./scripts/project-templates-postgres-smoke.sh",
    "test:smoke:ai-direct-chat-postgres": "./scripts/ai-direct-chat-postgres-smoke.sh",
    "test:smoke:ai-direct-chat": "./scripts/ai-direct-chat-smoke.sh",
    "test:e2e:project-templates": "./scripts/project-templates-e2e.sh",
    "test:e2e:rbac-authorization": "./scripts/rbac-authorization-e2e.sh",
    "test:integration:project-templates": "./scripts/project-templates-vitest.sh",
    "test:integration:external-runtime": "./scripts/external-runtime-vitest.sh",
    "test:smoke:external-runtime-postgres": "./scripts/external-runtime-postgres-smoke.sh",
    "test:smoke:external-runtime": "./scripts/external-runtime-smoke.sh",
    "test:smoke:backup": "./scripts/backup.sh",
    "test:smoke:backup-restore": "./scripts/backup-restore-smoke.sh",
    "test:smoke:dsh-real": "./scripts/real-dsh-smoke.sh",
    "test:membership": "./scripts/membership-smoke.sh",
    "typecheck": "pnpm run build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@types/node": "^24.10.1",
    "oxlint": "1.76.0",
    "prettier": "^3.6.2",
    "tsdown": "0.22.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
